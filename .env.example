# Bing Web Search v7
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=

# Azure AI Foundry (Grounding with Bing)
AI_PROJECT_ENDPOINT=
AI_PROJECT_CONNECTION_ID=
AI_PROJECT_MODEL_DEPLOYMENT=gpt-4o-mini
SEARCH_PROVIDER=bing_web

# Logging
BSC_LOG_LEVEL=INFO
BSC_SDK_LOG_LEVEL=ERROR
# Performance tracing
BSC_TRACE=false
# Prewarm and streaming
BSC_PREWARM=true
BSC_STREAM=true
BSC_WARMUP=true
BSC_WARMUP_DELAY_MS=1200
BSC_WARMUP_PROMPT=OK
